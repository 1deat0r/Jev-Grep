    "__schema1": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "__schema2": {
      "type": "object",
      "properties": {
        "include": {
          "$ref": "#/$defs/__schema3"
        },
        "exclude": {
          "$ref": "#/$defs/__schema3"
        }
      },
      "required": [
        "include",
        "exclude"
      ],
      "additionalProperties": false
    },
    "__schema3": {
      "maxItems": 64,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema4"
      }
    },
    "__schema4": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "__schema5": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "__schema6": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "__schema7": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?!\\/)(?!.*(?:^|\\/)\\.{1,2}(?:\\/|$))[^\\u0000\\\\\\r\\n/]+(?:\\/[^\\u0000\\\\\\r\\n/]+)*$"
    },
    "__schema8": {
      "type": "object",
      "properties": {
        "start": {
          "$ref": "#/$defs/__schema9"
        },
        "end": {
          "$ref": "#/$defs/__schema9"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "additionalProperties": false
    },
    "__schema9": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "__schema10": {
      "maximum": 1048576,
      "$ref": "#/$defs/__schema5"
    }
  },
  "$id": "urn:jev-grep:v1:request",
  "$comment": "Structural schema only. Enforce cross-field, UTF-8 byte, source, scope and authorization invariants in the runtime boundary. See docs/CONTRACTS.md."
