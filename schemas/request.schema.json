{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "version": {
          "$ref": "#/$defs/__schema0"
        },
        "requestId": {
          "$ref": "#/$defs/__schema1"
        },
        "workspaceId": {
          "$ref": "#/$defs/__schema1"
        },
        "scopePolicyId": {
          "$ref": "#/$defs/__schema1"
        },
        "narrow": {
          "$ref": "#/$defs/__schema2"
        },
        "operation": {
          "type": "string",
          "const": "exact"
        },
        "query": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "literal"
                },
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 8192
                },
                "caseSensitive": {
                  "type": "boolean"
                }
              },
              "required": [
                "kind",
                "text",
                "caseSensitive"
