              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "regex"
                },
                "pattern": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 8192
                },
                "caseSensitive": {
                  "type": "boolean"
                }
              },
              "required": [
                "kind",
                "pattern",
                "caseSensitive"
              ],
              "additionalProperties": false
            }
          ]
        },
        "maxMatches": {
          "maximum": 1000,
          "$ref": "#/$defs/__schema5"
        }
      },
      "required": [
        "version",
        "requestId",
        "workspaceId",
        "scopePolicyId",
        "operation",
        "query",
        "maxMatches"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "version": {
          "$ref": "#/$defs/__schema0"
        },
        "requestId": {
          "$ref": "#/$defs/__schema1"
        },
        "workspaceId": {
          "$ref": "#/$defs/__schema1"
        },
        "scopePolicyId": {
          "$ref": "#/$defs/__schema1"
        },
        "narrow": {
          "$ref": "#/$defs/__schema2"
        },
        "operation": {
          "type": "string",
          "const": "discover"
        },
        "question": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "anchors": {
          "maxItems": 16,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema6"
          }
        },
        "maxHits": {
          "maximum": 1000,
          "$ref": "#/$defs/__schema5"
        },
        "verifyLive": {
          "type": "boolean"
        }
      },
      "required": [
        "version",
        "requestId",
        "workspaceId",
        "scopePolicyId",
        "operation",
        "question",
        "anchors",
        "maxHits",
        "verifyLive"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "version": {
          "$ref": "#/$defs/__schema0"
        },
        "requestId": {
          "$ref": "#/$defs/__schema1"
        },
        "workspaceId": {
          "$ref": "#/$defs/__schema1"
        },
        "scopePolicyId": {
          "$ref": "#/$defs/__schema1"
        },
        "narrow": {
          "$ref": "#/$defs/__schema2"
        },
        "path": {
          "$ref": "#/$defs/__schema7"
        },
        "range": {
          "$ref": "#/$defs/__schema8"
        },
        "byteBudget": {
          "$ref": "#/$defs/__schema10"
        },
        "operation": {
          "type": "string",
          "const": "read-verified"
        },
        "expectedFileSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "version",
        "requestId",
        "workspaceId",
        "scopePolicyId",
        "path",
        "range",
        "byteBudget",
        "operation",
        "expectedFileSha256"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "version": {
          "$ref": "#/$defs/__schema0"
        },
        "requestId": {
          "$ref": "#/$defs/__schema1"
        },
        "workspaceId": {
          "$ref": "#/$defs/__schema1"
        },
        "scopePolicyId": {
          "$ref": "#/$defs/__schema1"
        },
        "narrow": {
          "$ref": "#/$defs/__schema2"
        },
        "path": {
          "$ref": "#/$defs/__schema7"
        },
        "range": {
          "$ref": "#/$defs/__schema8"
        },
        "byteBudget": {
          "$ref": "#/$defs/__schema10"
        },
        "operation": {
          "type": "string",
          "const": "read-fresh"
