  "$defs": {
    "__schema0": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "__schema1": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "INVALID_REQUEST",
            "UNSUPPORTED_VERSION",
            "UNAVAILABLE",
            "OUT_OF_SCOPE",
            "REVISION_MISMATCH",
            "READ_FAILED",
            "SOURCE_MUTATED",
            "POLICY_CHANGED",
            "LIMIT_REACHED",
            "BYTE_LIMIT",
            "CANCELLED",
            "DEADLINE",
            "INDEX_MISSING",
            "INDEX_INCOMPATIBLE",
            "INDEX_UNAVAILABLE",
            "INDEX_BUSY",
            "STORAGE_FULL",
            "PROVIDER_FAILED",
            "EGRESS_DENIED",
            "CAPABILITY_UNAVAILABLE"
          ]
        },
        "stage": {
          "type": "string",
          "enum": [
            "validation",
            "workspace",
            "read",
            "match",
            "index",
            "retrieval",
            "verify",
            "provider",
            "queue",
            "serialization"
          ]
        },
        "retryable": {
          "type": "boolean"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "path": {
          "$ref": "#/$defs/__schema2"
        },
        "nextAction": {
          "type": "string",
          "enum": [
            "narrow-scope",
            "retry-once",
            "use-exact",
            "request-index-create",
            "request-rebuild",
            "free-storage",
            "fix-request",
            "none"
          ]
        }
      },
      "required": [
        "code",
        "stage",
        "retryable",
        "message",
        "nextAction"
      ],
      "additionalProperties": false
    },
    "__schema2": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?!\\/)(?!.*(?:^|\\/)\\.{1,2}(?:\\/|$))[^\\u0000\\\\\\r\\n/]+(?:\\/[^\\u0000\\\\\\r\\n/]+)*$"
    },
    "__schema3": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "__schema4": {
      "maxItems": 64,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema5"
      }
    },
    "__schema5": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "__schema6": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "__schema7": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "__schema8": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "value": {
              "$ref": "#/$defs/__schema9"
            },
            "reason": {
              "type": "null"
            }
          },
          "required": [
            "value",
            "reason"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "value": {
              "type": "null"
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          },
          "required": [
            "value",
            "reason"
          ],
          "additionalProperties": false
        }
      ]
    },
    "__schema9": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "__schema10": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "__schema11": {
      "type": "string",
      "enum": [
        "limit",
        "cancelled",
        "read-failure",
        "deadline",
        "policy-changed",
        "source-mutated"
      ]
    },
    "__schema12": {
      "type": "object",
      "properties": {
        "evidence": {
          "$ref": "#/$defs/__schema13"
        },
        "provenance": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "exact"
            },
            "queryKind": {
              "type": "string",
              "enum": [
                "literal",
                "regex"
              ]
            },
            "matcherVersion": {
              "$ref": "#/$defs/__schema0"
            }
          },
          "required": [
            "kind",
            "queryKind",
            "matcherVersion"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "evidence",
        "provenance"
      ],
      "additionalProperties": false
    },
    "__schema13": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/__schema0"
        },
        "path": {
          "$ref": "#/$defs/__schema2"
        },
        "fileSha256": {
          "$ref": "#/$defs/__schema3"
        },
        "range": {
          "$ref": "#/$defs/__schema14"
        },
        "excerpt": {
          "type": "object",
          "properties": {
            "range": {
              "$ref": "#/$defs/__schema14"
            },
            "text": {
              "type": "string",
              "maxLength": 4096
            },
            "truncated": {
              "type": "boolean"
            }
          },
          "required": [
            "range",
            "text",
            "truncated"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "path",
        "fileSha256",
        "range",
        "excerpt"
      ],
      "additionalProperties": false
    },
    "__schema14": {
      "type": "object",
      "properties": {
        "start": {
          "$ref": "#/$defs/__schema9"
        },
        "end": {
          "$ref": "#/$defs/__schema9"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "additionalProperties": false
    },
    "__schema15": {
      "type": "string",
      "enum": [
        "byte-limit",
        "cancelled",
        "deadline"
      ]
    },
    "__schema16": {
      "type": "object",
      "properties": {
        "evidence": {
          "$ref": "#/$defs/__schema13"
        },
        "generationId": {
          "$ref": "#/$defs/__schema0"
        },
        "rank": {
          "maximum": 1000,
          "$ref": "#/$defs/__schema7"
        },
        "liveVerification": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "not-requested"
                }
              },
              "required": [
                "kind"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "matched"
                },
                "checkedAt": {
                  "$ref": "#/$defs/__schema10"
                },
                "observedFileSha256": {
                  "$ref": "#/$defs/__schema3"
                }
              },
              "required": [
                "kind",
                "checkedAt",
                "observedFileSha256"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "changed"
                },
                "checkedAt": {
                  "$ref": "#/$defs/__schema10"
                },
                "observedFileSha256": {
                  "$ref": "#/$defs/__schema3"
                }
              },
              "required": [
                "kind",
                "checkedAt",
                "observedFileSha256"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "unavailable"
                },
                "checkedAt": {
                  "$ref": "#/$defs/__schema10"
                },
                "issue": {
                  "$ref": "#/$defs/__schema1"
                }
              },
              "required": [
                "kind",
                "checkedAt",
                "issue"
              ],
              "additionalProperties": false
            }
          ]
        },
        "provenance": {
          "minItems": 1,
          "maxItems": 2,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema17"
          }
        }
      },
      "required": [
        "evidence",
        "generationId",
        "rank",
        "liveVerification",
        "provenance"
      ],
      "additionalProperties": false
    },
    "__schema17": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "lexical",
            "vector"
          ]
        },
        "configFingerprint": {
          "$ref": "#/$defs/__schema3"
        }
      },
      "required": [
        "kind",
        "configFingerprint"
      ],
      "additionalProperties": false
    }
