{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?!\\/)(?!.*(?:^|\\/)\\.{1,2}(?:\\/|$))[^\\u0000\\\\\\r\\n/]+(?:\\/[^\\u0000\\\\\\r\\n/]+)*$"
    },
    "fileSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "range": {
      "$ref": "#/$defs/__schema0"
    },
    "excerpt": {
      "type": "object",
      "properties": {
        "range": {
          "$ref": "#/$defs/__schema0"
        },
        "text": {
          "type": "string",
          "maxLength": 4096
        },
        "truncated": {
          "type": "boolean"
        }
      },
      "required": [
        "range",
        "text",
        "truncated"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "id",
    "path",
    "fileSha256",
    "range",
    "excerpt"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "object",
      "properties": {
        "start": {
          "$ref": "#/$defs/__schema1"
        },
        "end": {
          "$ref": "#/$defs/__schema1"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "additionalProperties": false
    },
    "__schema1": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "$id": "urn:jev-grep:v1:evidence",
  "$comment": "Structural schema only. Enforce cross-field, UTF-8 byte, source, scope and authorization invariants in the runtime boundary. See docs/CONTRACTS.md."
}
